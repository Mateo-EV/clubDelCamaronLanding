    ]
  }
] as const

const {
  name,
  icon: Icon,
  content,
  href
} = data.find(data => data.href === category)!

export const prerender = true
---

<Layout>
  <section
    class="mt-36 mb-20 flex flex-col items-center justify-between gap-10"
  >
    <div
      transition:name={href}
      class="aspect-square flex justify-center p-10 items-center bg-secondary rounded-full shadow-md"
    >
      <Icon className="size-48" />
    </div>
    <h1
      class="text-4xl lg:text-7xl font-mochiy leading-[3rem] lg:leading-[6rem] text-center animate-fade-in opacity-0 fill-mode-forwards duration-500 delay-300"
    >
      {name}
    </h1>
  </section>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="space-y-6">
      {
        content.map(
          ({ nombre, descripcion, imagen, ingredientes, notas, precio }) => (
            <div class="menu-card bg-white rounded-lg shadow-lg overflow-hidden">
              <div class="menu-image-container">
                <Image
                  src={imagen}
                  alt={nombre}
                  class="menu-image"
                  width={400}
                  height={400}
                />
              </div>
              <div class="p-4 flex-1 space-y-3">
                <h3 class="text-xl font-bold text-black">{nombre}</h3>
                <p class="text-gray-600 mt-1">{descripcion}</p>
                <ul class="text-gray-600 mt-1 space-y-1">
                  {ingredientes.map(ingrediente => (
                    <li>🌟 {ingrediente}</li>
                  ))}
                </ul>
                <div class="mt-3 flex justify-between items-center">
                  <span class="px-4 py-2 rounded-full bg-gradient-to-r from-[#FDBA72] to-[#FDC080] text-white text-lg font-semibold">
                    S/ {precio.toFixed(2)}
                  </span>
                  <span class="text-sm text-gray-500 italic">{notas}</span>
                </div>
              </div>
            </div>
          )
        )
      }
    </div>
  </div>
</Layout>

<style>
  .menu-image-container {
    width: 100%;
    max-width: 300px; /* Ancho máximo */
    aspect-ratio: 4/3; /* Relación de aspecto fija */
    overflow: hidden;
    border-radius: 0.5rem;
    flex-shrink: 0;
  }

  .menu-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .menu-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .menu-card {
      flex-direction: column; /* Cambia a columna en pantallas pequeñas */
    }
    .menu-image-container {
      max-width: 100%; /* Imagen ocupa el ancho completo */
    }
  }
</style>
