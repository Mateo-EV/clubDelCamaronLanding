          "Azúcar"
        ],
        imagen:
          "https://corkframes.com/cdn/shop/articles/the-traditional-mojito-recipe-a-refreshing-cuban-classic-954834.jpg?v=1722032218"
      },
      {
        nombre: "Mojito Maracuyá",
        precio: 18.0,
        descripcion: "Una variante tropical del clásico mojito.",
        notas: "Dulce y refrescante.",
        ingredientes: ["Ron blanco", "Maracuyá", "Hojas de menta", "Azúcar"],
        imagen:
          "https://cursosdecocina.cl/cdn/shop/articles/MOJITO-MARACUYA-BLGOG_2048x.progressive.jpg?v=1621490847"
      },
      {
        nombre: "Piña Colada",
        precio: 19.0,
        descripcion: "Cóctel cremoso y tropical de piña y coco.",
        notas: "Una experiencia caribeña.",
        ingredientes: ["Ron blanco", "Crema de coco", "Jugo de piña", "Hielo"],
        imagen: "https://imag.bonviveur.com/pina-colada.jpg"
      },
      {
        nombre: "Daiquiri",
        precio: 17.0,
        descripcion: "Cóctel clásico de ron con un toque cítrico.",
        notas: "Perfecto para una tarde relajante.",
        ingredientes: ["Ron blanco", "Jugo de limón", "Azúcar"],
        imagen:
